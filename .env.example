# === قاعدة البيانات (PostgreSQL) ===
# مثال: postgresql://user:password@host:5432/dbname
# في Vercel استخدم رابط الـ Pooler من Neon/Vercel Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# === حساب المالك (يُنشأ تلقائياً عند أول تشغيل) ===
ADMIN_NAME=محمد مروان
ADMIN_EMAIL=owner@marwan.local
ADMIN_PHONE=01110189255
ADMIN_PASSWORD=ChangeThisPassword123

# === (اختياري) رابط الموقع النهائي ===
# يُستخدم للروابط المطلقة إن لم تُضبط من لوحة التحكم ← SEO
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# === (للاستضافة على Vercel فقط) تخزين الصور ===
# يُنشأ من: Vercel Dashboard → Project → Storage → Add Blob Store
BLOB_READ_WRITE_TOKEN=
